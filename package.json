{
  "name": "guavabank",
  "version": "0.1.0",
  "private": true,
  "description": "Banco digital educacional em ambiente de simulação",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @guavabank/api",
    "dev:mobile": "npm run start --workspace @guavabank/mobile",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
